{
  "name": "vms-mobile-starter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace apps/mobile start",
    "dev:api": "npm --workspace apps/api run start:dev",
    "build:api": "npm --workspace apps/api run build",
    "test": "npm --workspace apps/mobile test",
    "typecheck": "npm --workspace apps/mobile run typecheck"
  }
}
