{
  "expo": {
    "name": "Mini Entrepôt",
    "slug": "vms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vms.minientrepot",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres des cartons et des emplacements."
      }
    },
    "android": {
      "package": "com.vms.minientrepot",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres des cartons et des emplacements.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
